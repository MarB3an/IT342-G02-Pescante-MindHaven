# =============================================================================
# MindHaven - Environment Configuration Template
# Copy this file to `.env` (never commit `.env` to Git) and fill in real values.
# =============================================================================

# --- Database (Supabase PostgreSQL - Northeast Asia Tokyo) ---
# Direct connection (requires IPv6 or Supabase IPv4 add-on):
DB_URL=jdbc:postgresql://db.vxinubzpzhjhgiogolbe.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
# IPv4 Session Pooler fallback (if direct connection times out on IPv4-only Wi-Fi):
# DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.vxinubzpzhjhgiogolbe
DB_PASSWORD=REPLACE_WITH_YOUR_SUPABASE_DB_PASSWORD
DB_SCHEMA=mindhaven

# --- Security & Cryptography ---
# Generate a 256-bit Base64 secret in PowerShell:
# [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
JWT_SECRET=REPLACE_WITH_32_BYTE_BASE64_SECRET
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
EMAIL_HASH_PEPPER=REPLACE_WITH_32_BYTE_BASE64_PEPPER
COOKIE_SECURE=false

# --- Campus Email Domain Restriction (comma-separated suffixes) ---
ALLOWED_EMAIL_DOMAINS=cit.edu,edu,edu.ph

# --- Initial System Administrator Bootstrap (first run only) ---
# Creates a real BCrypt-hashed ROLE_ADMIN account in PostgreSQL if absent.
ADMIN_EMAIL=admin@cit.edu
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_FULL_NAME=System Administrator

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173
